# Per-box cluster identity. Copy to instance/cluster.env on EACH box (gitignored) and edit for that box.
# LAN IPs only (no secrets). Supports MULTIPLE independent clusters (household + air-gap) via NET_NAME/VRID/VIP.

NET_NAME=household                 # household | airgap  (airgap => healthcheck is API-only, no household Midea ping)
ROLE=primary                       # primary (MASTER/150) | standby (BACKUP/100)
PEER_HOST=192.168.0.245            # the OTHER box's real IP  (leave empty = single-node cluster)
VIP=192.168.0.200                  # floating dictator address for THIS cluster
CIDR=24                            # VIP prefix length (default 24)
VRID=51                            # VRRP virtual_router_id — MUST be unique per L2 segment (household 51, air-gap 61)
IFACE=                             # empty = auto-detect the default-route iface; SET explicitly on a dual-homed
                                   #   box (e.g. .210's air-gap leg is wlp2s0, NOT its household default route)
BROKER_HOST=192.168.0.210          # the REAL dictator broker IP (NEVER the VIP — wifi STAs can't ARP a float)
CLUSTER_KEY=/home/visko/.ssh/id_cluster
REMOTE_REPO=/home/visko/home_automation
CONTROLLER_UNIT=ha-controller
RELAY_COORD_UNIT=ha-relay-coordinator   # Phase-B relay coordinator; notify.sh (re)starts on MASTER, stops on demote/fault
API=http://localhost:8123
DEBOUNCE=30                        # seconds the primary must be stably back before standby yields
POLL=5

# --- failover refinements (2026-06-24) ---
BACKUP_GRACE=4                     # notify.sh: secs to wait on BACKUP before stopping (ride out the boot transient)
PRIMARY_NODE=210                   # primary's cluster node-id; primary-watch reads ha/cluster/<id>/heartbeat
HEARTBEAT_FRESH=12                 # primary-watch MQTT cross-check: max age (s) of a heartbeat to trust

# Per-cluster examples:
#   household primary (.210): NET_NAME=household ROLE=primary PEER_HOST=192.168.0.245 VIP=192.168.0.200 VRID=51
#   household standby (.245): NET_NAME=household ROLE=standby PEER_HOST=192.168.0.210 VIP=192.168.0.200 VRID=51
#   air-gap  primary  (ha-2): NET_NAME=airgap    ROLE=primary PEER_HOST=              VIP=192.168.1.200 VRID=61 BROKER_HOST=192.168.1.210
#   air-gap  standby  (.210): NET_NAME=airgap    ROLE=standby PEER_HOST=192.168.1.210 VIP=192.168.1.200 VRID=61 IFACE=wlp2s0  (Phase 5)
