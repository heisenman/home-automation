# Instance data — never committed (real MACs, policies, secrets, runtime data)
instance/
venv/

# ESPHome / device real secrets — only the tracked *.example.yaml carries placeholders.
# Public repo: a real secrets.yaml must never be committable.
secrets.yaml
**/secrets.yaml
# Vendor firmware images (factory backups live off-git per D1001 discipline)
*.factory.bin
e1001-sensecraft-factory.bin

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Secrets / certs
*.pem
*.key
*.crt
*.p12
ca/

# Logs
*.log

# Imported data dumps & device diagnostics — local only, may carry PII (real MACs,
# location, account names). Root-anchored so tracked source (edge/esp32c6/partitions.csv) stays.
/*.csv
/bugreport-*.zip
/screenshot-*.png
*.btsnoop*

# ESPHome build artifacts
.esphome/
