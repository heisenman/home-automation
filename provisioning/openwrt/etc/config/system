# OpenWRT /etc/config/system — R7800, AIR-GAP net.
# NTP in an air gap: the R7800 has NO battery-backed RTC, so after a power loss its clock starts wrong and
# there's no internet NTP to fix it. Plan: the air-gap dictator (ha-2, .210 on this net) — and .210's
# bridge leg (.245 here) — carry the good/holdover clock; the router PEERS them and SERVES NTP to the edge
# nodes. TLS validity (ADR-0017) + signed-command freshness depend on sane time, so this matters.

config system
	option hostname 'ha-router-airgap'
	option timezone '__TZ__'           # POSIX TZ string, e.g. 'EST5EDT,M3.2.0,M11.1.0'
	option zonename '__ZONE__'         # e.g. 'America/New_York'
	option log_size '64'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '1'           # serve NTP to the LAN (router = LAN time anchor for edge nodes)
	list server '192.168.1.210'        # peer ha-2 (air-gap dictator) as the upstream time source
	list server '192.168.1.245'        # and .210's air-gap leg as a backup source
	# NO internet pool servers — air gap.
