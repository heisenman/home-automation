# Instance data — never committed (real MACs, policies, secrets, runtime data)
instance/
venv/

# ESPHome / device real secrets — only the tracked *.example.yaml carries placeholders.
# Public repo: a real secrets.yaml must never be committable.
secrets.yaml
**/secrets.yaml
# Vendor firmware images (factory backups live off-git per D1001 discipline)
*.factory.bin
e1001-sensecraft-factory.bin

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Secrets / certs
*.pem
*.key
*.crt
*.p12
ca/
# EXCEPTION (ADR-0038): the Android app pins the server certificate, so its bundled copy is a BUILD INPUT —
# without it a fresh clone produces an app that trusts nothing and cannot reach the house at all. A server
# certificate is public by construction (it is presented to every TLS client); the private half stays
# ignored above. tests/test_android_cert_pin.py asserts this copy matches instance/tls/server.crt and
# carries no key material.
!app/android/app/src/main/res/raw/ha_server.crt

# Logs
*.log

# Imported data dumps & device diagnostics — local only, may carry PII (real MACs,
# location, account names). Root-anchored so tracked source (edge/esp32c6/partitions.csv) stays.
/*.csv
/bugreport-*.zip
/screenshot-*.png
*.btsnoop*

# ESPHome build artifacts
.esphome/

# Vendor datasheets: local reference only, NEVER committed to the PUBLIC repo (some are marked confidential,
# e.g. DS_SY6974B.pdf = "Silergy Corp. Confidential - Prepared for Customer Use Only"). Blanket-ignore every PDF
# in docs/hardware/ so any datasheet dropped in is auto-excluded; the ONE exception is the Seeed schematic
# (CC BY-SA, explicitly shareable). Drop datasheets here locally for docs-first; they don't sync via git.
docs/hardware/*.pdf
!docs/hardware/reTerminal_E1001_V1_2_SCH_251120.pdf
