[Unit]
Description=ha-2 weather pull via air-gap relay (ADR-0033 Phase 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=visko
WorkingDirectory=/home/visko/home_automation
EnvironmentFile=/home/visko/home_automation/instance/relay.env
ExecStart=/home/visko/home_automation/venv/bin/python provisioning/airgap/relay/relay-weather-client.py
