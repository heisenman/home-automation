# OpenWRT /etc/config/network — the AIR-GAP HA network's router (Netgear R7800, ipq806x, DSA).
# Subnet: 192.168.1.0/24, gateway .1 = this router. This is a SEPARATE, PERMANENT network from the
# household internet net (192.168.0.0/24) — deliberately a different subnet so the bridge host .210 can
# hold one interface on EACH net without a same-subnet collision (see docs/airgap/MIGRATION-DESIGN-LOG.md,
# DJ-5). NOT a plug-swap of the household router.
#
# KEY DESIGN — single bridged L2 segment (br-lan = LAN ports + both wifi radios), NO VLAN split. This is
# the fix for `vip-unreachable-from-wifi`: with wifi + wired on one bridge and AP isolation OFF
# (./wireless), ARP + keepalived's gratuitous-ARP for the floating VIP .200 cross the bridge, so wifi
# edge nodes follow a dictator failover. A VLAN/L3 split would re-break that — keep HA devices on one seg.

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	# the two wifi radios join br-lan via option network 'lan' in ./wireless

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'        # air-gap gateway = every air-gap host's gateway
	option netmask '255.255.255.0'
	option ip6assign '60'
	# .200 (VIP, VRRP-managed) / .210 (ha-2 dictator) / .245 (.210 bridge leg) are reserved out of the
	# DHCP pool in ./dhcp — the router must never claim .200 nor hand it out.

# ── WAN ───────────────────────────────────────────────────────────────────────────
# AIR GAP: no uplink, ever. WAN stays DISABLED (commented). This net is genuinely isolated — there is no
# transitional-uplink story here (the household net keeps the family's internet; this one never touches it).
