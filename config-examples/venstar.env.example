# Venstar ColorTouch thermostat — local API address + credentials (ADR-0043). No cloud: the API is LAN-only.
# Copy to  instance/venstar.env  (gitignored, owner-only) and fill in. NEVER commit credentials.
#   cp config-examples/venstar.env.example instance/venstar.env && chmod 600 instance/venstar.env
#
# Its static lease lives on the air-gap router (instance/openwrt/airgap_router.env), like the Midea's.
VENSTAR_HOST=192.168.1.x
# http, or https once its HTTPS option is on (self-signed; verification is off — the air gap is the boundary)
VENSTAR_PROTO=http
# Set in the thermostat's API menu when "authentication" is enabled (HTTP digest). Blank = none.
VENSTAR_USER=
VENSTAR_PASS=
# Only if Screen Lock is enabled on the unit (then every control/settings call needs it).
VENSTAR_PIN=
