# Voluntary grid load-shed (ADR-0037) — copy to instance/grid-shed.env (gitignored).
# Runs on .210 via ha-grid-shed.timer. UNTIL HA_GRID_SOURCE IS SET THE LANE REFUSES TO RUN, so the
# units can be installed safely before the trigger question is settled.

# ── the trigger ───────────────────────────────────────────────────────────────────
# PGE publishes NO machine-readable load-warning signal: Peak Time Events go out to enrolled customers
# by email/SMS only, portlandgeneral.com/peak-time-events carries no event status or JSON, and the
# unofficial portlandgeneral-api GraphQL library needs account credentials and exposes billing/usage,
# not events. So the trigger is a choice:
#
#   schedule  fixed daily window over a season. No signal, no credentials, no guessing. PGE's summer
#             peak season is Jun 1 - Sep 30 with events typically 5-9pm, so this captures the peak-hour
#             saving whether or not an event is actually called.
#   nws       shed during the window only on days api.weather.gov has an active heat alert for your
#             point (keyless). A PROXY for a peak event, not the event: fires on days PGE called
#             nothing, and misses any event that was not heat-driven.
#   imap      (not implemented) ingest PGE's own peak-event mail — the highest-fidelity option, it
#             carries the real start/stop times. Needs a real sample message to parse; writing a parser
#             against an imagined format would be guesswork.
#   manual    (not implemented) remote "grid event" trigger. Needs a decision on PWA control vs an
#             ntfy-driven hook.
HA_GRID_SOURCE=

# ── what to curtail ───────────────────────────────────────────────────────────────
# Comma-separated control device_ids. These get a manual override "off" for the window, which for the
# dehumidifier also parks its setpoint at the inert end (ADR-0011 addendum) so it genuinely stops
# rather than idling against its old target.
HA_GRID_DEVICES=dehumidifier_living_room,purifier_living_room

# ── the guardrail ─────────────────────────────────────────────────────────────────
# Per device: the value at or above which a shed is VETOED, and an already-running shed is ABORTED.
# Read in THAT DEVICE'S OWN control metric, from its own authoritative control sensor — the same number
# its automation runs on. The units differ per device and are NOT comparable, which is exactly why there
# is no single global ceiling:
#
#   dehumidifier_living_room  %RH     rule runs 44 on / 40 off, so 55 sits well clear of normal while
#                                     still catching a real humidity problem with nobody home.
#   purifier_living_room      ug/m3   PM2.5. Its speed bands are 12/35/55, and 35 is the US AQI
#                                     "unhealthy for sensitive groups" line. This is the guardrail that
#                                     matters in a Pacific NW heat wave: heat waves are wildfire smoke
#                                     season, and shutting the purifier off into smoke to save a few
#                                     cents is the wrong trade.
#
# Every device in HA_GRID_DEVICES must appear here or the lane refuses to start — an unlisted device is
# caught at startup, not discovered at 5pm. Use '<device>:none' to deliberately shed with no guardrail.
# NOTE: an RH ceiling on the purifier would be permanently unverifiable (it reports no humidity), so it
# would silently never shed while everything looked healthy. Hence per-device, per-metric.
HA_GRID_GUARDRAILS=dehumidifier_living_room:55,purifier_living_room:35

# If the control sensor is older than this, the guardrail is UNVERIFIABLE and the lane does not shed
# (and releases one in progress). Failing toward comfort is deliberate.
HA_GRID_MAX_SENSOR_AGE_S=900

# ── window / season ───────────────────────────────────────────────────────────────
# Local wall-clock on purpose: a utility peak window is defined as "5-9pm" and must track DST.
HA_GRID_WINDOW=17:00-21:00
HA_GRID_SEASON=06-01..09-30
# The UTILITY's timezone, NOT the box's. .210 runs on UTC — reading "17:00-21:00" as box-local would
# shed 10:00-14:00 Pacific, the wrong four hours, every day, with nothing in the logs looking odd.
HA_GRID_TZ=America/Los_Angeles

# ── plumbing ──────────────────────────────────────────────────────────────────────
# The control plane on the VIP. Commands go through the same admin API a human uses from the PWA; the
# bearer is derived locally from the master passphrase and never stored.
HA_GRID_API=http://192.168.1.200:8123
# source=nws needs a point; falls back to HA_WEATHER_LAT/HA_WEATHER_LON from instance/weather.env.
#HA_GRID_LAT=
#HA_GRID_LON=
#HA_GRID_STATE=instance/grid-shed.state.json
